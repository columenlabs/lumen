{
  "name": "lumen-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "rm -rf dist && bun scripts/changelog.ts && storybook build --quiet -o dist/docs && bun scripts/llms.ts && cp _redirects dist/",
    "lint": "biome check .storybook stories scripts && ../packages/ship/scripts/check-kit-neutral.sh .storybook stories scripts package.json",
    "type-check": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@columenlabs/lumen-ui": "workspace:*",
    "@columenlabs/lumen-ui-types": "workspace:*",
    "lucide-react": "^1.48.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-mcp": "10.6.2",
    "@storybook/addon-themes": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "6.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "4.22.1",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  }
}
