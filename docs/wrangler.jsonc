// The docs site at lumen.columenlabs.com: static files only, no Worker code. `bun run build` writes
// dist/: Storybook and the component manifest in dist/docs, and at the root llms.txt, llms-full.txt
// and each package's README as <package>.md. `/` redirects to /docs/ (_redirects).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumen-docs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "lumen.columenlabs.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
