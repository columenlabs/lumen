{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignore": ["node_modules", "dist", "out", "**/*.md", "packages/ui/src/ui/**"]
  },
  "organizeImports": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "useHookAtTopLevel": "error"
      },
      "style": {
        "noNonNullAssertion": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "include": ["packages/**/*.ts", "packages/**/*.tsx"],
      "linter": {
        "rules": {
          "nursery": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@ai-sdk/openai": "Model calls go through aiModel() in lumen-ai (agent/models.ts), which keeps the prompt cache on.",
                  "@ai-sdk/anthropic": "Model calls go through aiModel() in lumen-ai (agent/models.ts), which keeps the prompt cache on.",
                  "openai": "Text calls go through aiModel() in lumen-ai (agent/models.ts), which keeps the prompt cache on.",
                  "@anthropic-ai/sdk": "Text calls go through aiModel() in lumen-ai (agent/models.ts), which keeps the prompt cache on."
                }
              }
            }
          }
        }
      }
    },
    {
      "include": ["packages/ai/src/agent/models.ts", "packages/ai/src/assistant/engine.ts"],
      "linter": {
        "rules": {
          "nursery": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
