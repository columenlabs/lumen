{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@columenlabs/lumen-types": ["../lumen-types/dist/index.d.ts"],
      "@columenlabs/lumen-types/*": ["../lumen-types/dist/*.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
